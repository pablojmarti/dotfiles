{
  "distro": "alpine",
  "alpine": {
    "version": "3.23.7",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "rootfsPackages": [
      "linux-virt",
      "rng-tools",
      "bash",
      "ca-certificates",
      "ca-certificates-bundle",
      "curl",
      "e2fsprogs",
      "e2fsprogs-extra",
      "nodejs",
      "npm",
      "uv",
      "python3",
      "openssh",
      "git",
      "build-base",
      "cmake",
      "clang21",
      "clang21-extra-tools",
      "compiler-rt",
      "llvm21",
      "freetype-dev",
      "sdl3-dev",
      "pkgconf",
      "ninja",
      "gtest",
      "alsa-lib-dev",
      "pulseaudio-dev",
      "portaudio-dev",
      "fribidi-dev",
      "jack-dev",
      "sndio-dev",
      "libx11-dev",
      "libxext-dev",
      "libxrandr-dev",
      "libxcursor-dev",
      "libxfixes-dev",
      "libxi-dev",
      "libxscrnsaver-dev",
      "libxtst-dev",
      "libxkbcommon-dev",
      "libdrm-dev",
      "mesa-dev",
      "mesa-gles",
      "pipewire-dev",
      "wayland-dev",
      "libdecor-dev",
      "liburing-dev",
      "mesa-egl",
      "dbus-dev",
      "ibus-dev",
      "eudev-dev",
      "libthai-dev",
      "libusb-dev"
    ],
    "initramfsPackages": []
  },
  "rootfs": {
    "label": "gondolin-root"
  },
  "env": {
    "ASAN_SYMBOLIZER_PATH": "/usr/lib/llvm21/bin/llvm-symbolizer"
  }
}
